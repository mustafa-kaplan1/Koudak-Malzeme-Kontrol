@model KoudakMalzeme.Shared.Entities.Kullanici
@{
	ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="row justify-content-center">
	<div class="col-md-8">
		<div class="card shadow-sm border-0">
			<div class="card-header bg-primary text-white">
				<h5 class="mb-0"><i class="fa-solid fa-user-pen me-2"></i> Kullanıcı Düzenle</h5>
			</div>
			<div class="card-body">
				<form asp-action="Duzenle" method="post">
					<input type="hidden" asp-for="Id" />
					<input type="hidden" asp-for="PasswordHash" />
					<input type="hidden" asp-for="PasswordSalt" />

					<div class="row">
						<div class="col-md-6 mb-3">
							<label asp-for="Ad" class="form-label fw-bold">Ad</label>
							<input asp-for="Ad" class="form-control" required />
						</div>
						<div class="col-md-6 mb-3">
							<label asp-for="Soyad" class="form-label fw-bold">Soyad</label>
							<input asp-for="Soyad" class="form-control" required />
						</div>
					</div>

					<div class="row">
						<div class="col-md-6 mb-3">
							<label asp-for="OkulNo" class="form-label fw-bold">Okul No</label>
							<input asp-for="OkulNo" class="form-control" required />
						</div>
						<div class="col-md-6 mb-3">
							<label asp-for="Rol" class="form-label fw-bold">Kullanıcı Rolü</label>
							<select asp-for="Rol" class="form-select"
								asp-items="Html.GetEnumSelectList<KoudakMalzeme.Shared.Enums.KullaniciRolu>()"></select>
						</div>
					</div>

					<div class="mb-3">
						<label asp-for="Email" class="form-label">E-Posta</label>
						<input asp-for="Email" type="email" class="form-control" required />
					</div>

					<div class="mb-3">
						<label asp-for="Telefon" class="form-label">Telefon</label>
						<input asp-for="Telefon" class="form-control" />
					</div>

					@if (!Model.IlkGirisYapildiMi)
					{
						<hr class="my-4" />
						<h6 class="text-warning mb-3">
							<i class="fa-solid fa-key me-2"></i> Geçici Şifre Düzenle
						</h6>
						<div class="row">
							<div class="col-md-8 mb-3">
								<label class="form-label fw-bold">Yeni Geçici Şifre</label>
								<div class="input-group">
									<input type="text" id="tempPassword" class="form-control" placeholder="Şifre giriniz veya otomatik oluştur" />
									<button type="button" id="generateTempBtn" class="btn btn-outline-secondary">Otomatik Oluştur</button>
								</div>
								<small class="text-muted d-block mt-2">Bu şifre kullanıcının ilk girişini tamamladıktan sonra değiştirilecektir.</small>
								<input type="hidden" name="TempPassword" id="tempPasswordHidden" />
								<input type="hidden" name="GenerateTempRandom" id="generateTempRandomHidden" value="false" />
							</div>
						</div>
					}

					<div class="form-check mb-4">
						<input asp-for="IlkGirisYapildiMi" class="form-check-input" type="checkbox" id="chkIlkGiris">
						<label class="form-check-label text-muted" for="chkIlkGiris">
							İlk giriş yapıldı (Şifre sıfırlamak için işareti kaldırın)
						</label>
					</div>

					<div class="d-flex justify-content-end gap-2">
						<a asp-action="Yonetim" class="btn btn-secondary">İptal</a>
						<button type="submit" class="btn btn-primary px-4">Değişiklikleri Kaydet</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		function generateStrongPassword(length) {
			length = length || 16;
			var upper = "ABCDEFGHJKLMNOPQRSTUVWXYZ";
			var lower = "abcdefghijkmnopqrstuvwxyz";
			var digits = "0123456789";
			var special = "!@@#$%^&*()-_=+[]{};:,.<>?";
			var all = upper + lower + digits + special;
			var pwd = '';
			pwd += upper[Math.floor(Math.random() * upper.length)];
			pwd += lower[Math.floor(Math.random() * lower.length)];
			pwd += digits[Math.floor(Math.random() * digits.length)];
			pwd += special[Math.floor(Math.random() * special.length)];
			for (var i = 4; i < length; i++) {
				pwd += all[Math.floor(Math.random() * all.length)];
			}
			return pwd.split('').sort(function(){return 0.5-Math.random()}).join('');
		}

		document.getElementById('generateTempBtn')?.addEventListener('click', function (e) {
			e.preventDefault();
			var pwd = generateStrongPassword(16);
			document.getElementById('tempPassword').value = pwd;
			document.getElementById('tempPasswordHidden').value = pwd;
			document.getElementById('generateTempRandomHidden').value = 'true';
		});

		document.getElementById('tempPassword')?.addEventListener('input', function () {
			document.getElementById('tempPasswordHidden').value = this.value;
			document.getElementById('generateTempRandomHidden').value = 'false';
		});
	</script>
}