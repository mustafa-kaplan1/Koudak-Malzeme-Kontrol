@model KoudakMalzeme.Shared.Dtos.AdminUyeEkleDto
@{
	ViewData["Title"] = "Yeni Üye Ekle";
}

<div class="row justify-content-center">
	<div class="col-md-6">
		<div class="card shadow-sm border-0">
			<div class="card-header bg-success text-white">
				<h5 class="mb-0"><i class="fa-solid fa-user-plus me-2"></i> Yeni Üye Kaydı</h5>
			</div>
			<div class="card-body">
				@if (TempData["Hata"] != null)
				{
					<div class="alert alert-danger">@TempData["Hata"]</div>
				}

				<form asp-action="Ekle" method="post">
					<div class="mb-3">
						<label asp-for="OkulNo" class="form-label fw-bold">Okul Numarası</label>
						<input asp-for="OkulNo" class="form-control" placeholder="Örn: 2023101" required />
						<span asp-validation-for="OkulNo" class="text-danger small"></span>
					</div>

					<div class="mb-3">
						<label asp-for="Email" class="form-label fw-bold">E-Posta Adresi</label>
						<input asp-for="Email" type="email" class="form-control" placeholder="ogrenci@okul.edu.tr"
							required />
						<span asp-validation-for="Email" class="text-danger small"></span>
					</div>

					<div class="row">
						<div class="col-md-6 mb-3">
							<label asp-for="Ad" class="form-label">Ad (Opsiyonel)</label>
							<input asp-for="Ad" class="form-control" />
						</div>
						<div class="col-md-6 mb-3">
							<label asp-for="Soyad" class="form-label">Soyad (Opsiyonel)</label>
							<input asp-for="Soyad" class="form-control" />
						</div>
					</div>

					<div class="alert alert-info small">
						<i class="fa-solid fa-info-circle me-1"></i> Not: Üye ilk girişinde şifresini kendisi
						belirleyecektir.
					</div>

					<div class="mb-3">
						<label class="form-label fw-bold">Geçici Şifre (Opsiyonel)</label>
						<div class="input-group">
							<input name="Password" id="tempPassword" class="form-control" placeholder="Boş bırakılırsa otomatik/varsayılan şifre verilir" />
							<button type="button" id="generateBtn" class="btn btn-outline-secondary">Otomatik Oluştur</button>
							<input type="hidden" name="GenerateRandom" id="generateRandom" value="false" />
						</div>
						<small class="text-muted">İsterseniz buraya manuel şifre yazabilir veya otomatik oluşturabilirsiniz.</small>
					</div>

					<div class="d-flex justify-content-between">
						<a asp-action="Yonetim" class="btn btn-outline-secondary">İptal</a>
						<button type="submit" class="btn btn-success px-4">Kaydet</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		function generateStrongPassword(length) {
			length = length || 16;
			var upper = "ABCDEFGHJKLMNOPQRSTUVWXYZ";
			var lower = "abcdefghijkmnopqrstuvwxyz";
			var digits = "0123456789";
			var special = "!@@#$%^&*()-_=+[]{};:,.<>?";
			var all = upper + lower + digits + special;
			var pwd = '';
			pwd += upper[Math.floor(Math.random() * upper.length)];
			pwd += lower[Math.floor(Math.random() * lower.length)];
			pwd += digits[Math.floor(Math.random() * digits.length)];
			pwd += special[Math.floor(Math.random() * special.length)];
			for (var i = 4; i < length; i++) {
				pwd += all[Math.floor(Math.random() * all.length)];
			}
			// Shuffle
			return pwd.split('').sort(function(){return 0.5-Math.random()}).join('');
		}

		document.getElementById('generateBtn').addEventListener('click', function () {
			var pwd = generateStrongPassword(16);
			document.getElementById('tempPassword').value = pwd;
			document.getElementById('generateRandom').value = 'true';
		});

		document.getElementById('tempPassword').addEventListener('input', function () {
			// If admin types manually, ensure GenerateRandom false
			document.getElementById('generateRandom').value = 'false';
		});
	</script>
}